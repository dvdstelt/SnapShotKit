<Project>
  <!--
    The version comes from the nearest git tag, so a release is cut by tagging and nothing else.
    An untagged commit builds as a pre-release of the next patch; the tag v0.2.0 builds as 0.2.0.
    CI must check out with fetch-depth 0, or MinVer sees no tags and silently versions everything 0.0.0.

    A source tarball has no history at all, which is how COPR builds. The Makefile passes VERSION
    through as MinVerVersionOverride for exactly that case.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
