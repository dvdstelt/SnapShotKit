<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SnapShotKit.Daemon</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>snapshotkitd</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SnapShotKit.Contracts\SnapShotKit.Contracts.csproj" />
    <ProjectReference Include="..\SnapShotKit.Portal\SnapShotKit.Portal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

</Project>
