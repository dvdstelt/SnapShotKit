[Desktop Entry]
Type=Application
Name=SnapShotKit
GenericName=Screenshot Editor
Comment=Capture a region of the screen and annotate it
Exec=snapshotkit-editor %f
Icon=snapshotkit
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;GTK;
MimeType=application/vnd.snapshotkit.snapshot;image/png;image/jpeg;image/webp;image/bmp;image/gif;image/tiff;
Keywords=screenshot;capture;annotate;screen;snip;
StartupNotify=true
StartupWMClass=snapshotkit-editor
